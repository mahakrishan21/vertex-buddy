 "vo": [
  {
   "id": "a1",
   "at": 0.4,
   "duration": 2.475,
   "text": "What if you always knew the moment Claude needed you?"
  },
  {
   "id": "b1",
   "at": 4.3,
   "duration": 1.6,
   "text": "Claude Code works on its own."
  },
  {
   "id": "b2",
   "at": 6.4,
   "duration": 3.797,
   "text": "But when it stops to ask, it just waits. Somewhere behind your windows."
  },
  {
   "id": "c1",
   "at": 10.8,
   "duration": 1.216,
   "text": "Meet Vertex Buddy!"
  },
  {
   "id": "c2",
   "at": 13.2,
   "duration": 3.797,
   "text": "It floats above every app on your Mac, and watches every session for you."
  },
  {
   "id": "d1",
   "at": 18.3,
   "duration": 1.408,
   "text": "Green: Claude's working."
  },
  {
   "id": "d2",
   "at": 20.3,
   "duration": 1.536,
   "text": "Yellow: finished. Your turn!"
  },
  {
   "id": "d3",
   "at": 22.3,
   "duration": 1.451,
   "text": "Pink: it needs your answer."
  },
  {
   "id": "e1",
   "at": 24.4,
   "duration": 1.643,
   "text": "Hover, and see every session."
  },
  {
   "id": "e2",
   "at": 27.3,
   "duration": 1.472,
   "text": "Click, and you're straight back in."
  },
  {
   "id": "e3",
   "at": 30.8,
   "duration": 1.109,
   "text": "Drag it anywhere."
  },
  {
   "id": "f1",
   "at": 33.3,
   "duration": 1.067,
   "text": "Four characters."
  },
  {
   "id": "f2",
   "at": 35.3,
   "duration": 1.109,
   "text": "Nine behaviours."
  },
  {
   "id": "f3",
   "at": 37.8,
   "duration": 1.067,
   "text": "Twelve faces."
  },
  {
   "id": "g1",
   "at": 39.9,
   "duration": 0.917,
   "text": "No hooks."
  },
  {
   "id": "g2",
   "at": 41,
   "duration": 1.493,
   "text": "No changes to your settings."
  },
  {
   "id": "g3",
   "at": 42.6,
   "duration": 1.301,
   "text": "Nothing leaves your Mac."
  },
  {
   "id": "h1",
   "at": 44.5,
   "duration": 2.56,
   "text": "Claude does the work. Vertex keeps you in the loop."
  }
 ],
