 "vo": [
  {
   "id": "n1",
   "at": 0.4,
   "duration": 2.368,
   "text": "Working with Claude Code, you start in the loop."
  },
  {
   "id": "n2",
   "at": 3.8,
   "duration": 1.685,
   "text": "Then one session becomes five."
  },
  {
   "id": "v2",
   "at": 6.8,
   "duration": 1.813,
   "text": "So you hand them off, and step away."
  },
  {
   "id": "n4",
   "at": 9.8,
   "duration": 2.005,
   "text": "And one of them stops. It needs you."
  },
  {
   "id": "v5",
   "at": 14,
   "duration": 1.28,
   "text": "Meet Vertex Buddy."
  },
  {
   "id": "v6",
   "at": 16.7,
   "duration": 3.115,
   "text": "It floats above every app on your Mac, and watches them all."
  },
  {
   "id": "x1",
   "at": 20.8,
   "duration": 1.557,
   "text": "Asleep when nothing's running."
  },
  {
   "id": "x2",
   "at": 23.3,
   "duration": 1.643,
   "text": "Calm when sessions are open."
  },
  {
   "id": "x3",
   "at": 25.8,
   "duration": 1.451,
   "text": "Busy when Claude's working."
  },
  {
   "id": "x4",
   "at": 28.3,
   "duration": 1.557,
   "text": "Delighted when one finishes."
  },
  {
   "id": "x5",
   "at": 30.8,
   "duration": 1.621,
   "text": "Unmissable when one needs you."
  },
  {
   "id": "v8",
   "at": 33.3,
   "duration": 2.709,
   "text": "Hover for every session. Click, and you're back in."
  },
  {
   "id": "v9",
   "at": 37.25,
   "duration": 3.072,
   "text": "Four characters. Nine behaviours. Twelve faces."
  },
  {
   "id": "v10",
   "at": 41.3,
   "duration": 3.435,
   "text": "No hooks. No settings to change. Nothing leaves your Mac."
  },
  {
   "id": "v11",
   "at": 46.95,
   "duration": 2.645,
   "text": "Claude does the work. Vertex keeps you in the loop."
  }
 ],
