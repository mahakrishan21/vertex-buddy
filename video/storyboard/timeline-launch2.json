 "vo": [
  {
   "id": "a1",
   "at": 0.4,
   "duration": 2.581,
   "text": "What if you always knew the moment Claude needed you?"
  },
  {
   "id": "b1",
   "at": 4.8,
   "duration": 1.664,
   "text": "Claude Code works on its own."
  },
  {
   "id": "b2",
   "at": 6.9,
   "duration": 3.947,
   "text": "But when it stops to ask, it waits quietly, somewhere behind your windows."
  },
  {
   "id": "c1",
   "at": 12.3,
   "duration": 1.323,
   "text": "Meet Vertex Buddy."
  },
  {
   "id": "c2",
   "at": 14.7,
   "duration": 4.8,
   "text": "A little companion that floats above every app on your Mac, and watches your sessions for you."
  },
  {
   "id": "d1",
   "at": 20.3,
   "duration": 1.621,
   "text": "Green means Claude is working."
  },
  {
   "id": "d2",
   "at": 22.8,
   "duration": 1.323,
   "text": "Yellow: it's finished."
  },
  {
   "id": "d3",
   "at": 25.3,
   "duration": 1.557,
   "text": "Pink: it needs your answer."
  },
  {
   "id": "e1",
   "at": 27.9,
   "duration": 1.728,
   "text": "Hover, and see every session."
  },
  {
   "id": "e2",
   "at": 31.3,
   "duration": 2.517,
   "text": "Click, and you're straight back in the one that's waiting."
  },
  {
   "id": "f1",
   "at": 35.3,
   "duration": 1.088,
   "text": "Four characters."
  },
  {
   "id": "f2",
   "at": 37.8,
   "duration": 1.131,
   "text": "Nine behaviours."
  },
  {
   "id": "f3",
   "at": 40.3,
   "duration": 1.109,
   "text": "Twelve faces."
  },
  {
   "id": "g1",
   "at": 42.9,
   "duration": 0.939,
   "text": "No hooks."
  },
  {
   "id": "g2",
   "at": 44.3,
   "duration": 1.557,
   "text": "No changes to your settings."
  },
  {
   "id": "g3",
   "at": 46.3,
   "duration": 1.344,
   "text": "Nothing leaves your Mac."
  },
  {
   "id": "h1",
   "at": 48.5,
   "duration": 2.645,
   "text": "Claude does the work. Vertex keeps you in the loop."
  }
 ],
